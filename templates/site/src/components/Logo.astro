---
// The business logo in the header (US-14 FR-008, plan decision 6): the light version by default and the dark one
// under prefers-color-scheme: dark, with width and height read from the file. Rendered only for a confirmed logo;
// its files are published by src/pages/brand/[file].ts, so no other image of the repo reaches dist/.
import { imageMetadata } from 'astro/assets/utils';
import { logoFiles } from '../lib/logo.ts';
import type { Logo } from '../lib/site.ts';

interface Props {
  logo: Logo;
}

const { logo } = Astro.props;
const [light, dark] = logoFiles(logo, __SITE_ROOT__);
if (!light) throw new Error('relevamiento: "brief.logo.light" has no file');
const size = await imageMetadata(light.bytes, logo.light);
---

<picture class="brand-logo">
  {dark && <source media="(prefers-color-scheme: dark)" srcset={dark.url} />}
  <img src={light.url} alt={logo.alt} width={size.width} height={size.height} decoding="async" />
</picture>
