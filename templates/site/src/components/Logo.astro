---
import { getImage } from 'astro:assets';
// The business logo in the header (US-14 FR-008, plan decision 6): the light version by default and the dark one
// under prefers-color-scheme: dark, through astro:assets so it carries width and height. The validator already
// checked that both paths are images under src/assets/ inside the repo; a file the glob cannot see fails the build.
import type { ImageMetadata } from 'astro';
import type { Logo } from '../lib/site.ts';

interface Props {
  logo: Logo;
}

const files = import.meta.glob<ImageMetadata>('/src/assets/**/*.{svg,png,jpg,jpeg,webp,avif}', {
  eager: true,
  import: 'default',
});

function asset(rel: string, field: string): ImageMetadata {
  const meta = files[`/${rel}`];
  if (!meta) throw new Error(`relevamiento: "brief.logo.${field}" is not an image under src/assets: ${rel}`);
  return meta;
}

const { logo } = Astro.props;
const lightMeta = asset(logo.light, 'light');
const light = await getImage({ src: lightMeta });
const dark = logo.dark ? await getImage({ src: asset(logo.dark, 'dark') }) : undefined;
---

<picture class="brand-logo">
  {dark && <source media="(prefers-color-scheme: dark)" srcset={dark.src} />}
  <img
    src={light.src}
    alt={logo.alt}
    width={lightMeta.width}
    height={lightMeta.height}
    decoding="async"
  />
</picture>
