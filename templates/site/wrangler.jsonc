// Static-only deploy on Cloudflare Workers (ADR-0030): no Worker script, assets only.
// dist/_headers applies to every asset response. "none" serves a real 404 for unknown
// paths instead of index.html with 200 (no soft-404).
{
  "name": "specmate-spike-plantilla",
  "compatibility_date": "2026-11-12",
  "assets": {
    "directory": "./dist/",
    "not_found_handling": "none"
  }
}
