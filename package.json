{
  "name": "specmate",
  "private": true,
  "description": "De la carpeta del cliente a la web publicada: sitios estáticos para negocios, seguros, con tests y diseño propio.",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm test --workspaces --if-present && npm test --prefix templates/site",
    "lint": "npm run lint --workspaces --if-present"
  },
  "devDependencies": {
    "modern-web-guidance": "1.0.0"
  }
}
